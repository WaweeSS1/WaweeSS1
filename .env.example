# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token
WEBAPP_URL=https://miniapp.fxking.io

# ── Database (PostgreSQL — EU region, GDPR) ───────────────
DATABASE_URL=postgresql://user:password@host:5432/fxking?sslmode=require

# ── Redis (Upstash or self-hosted) ────────────────────────
REDIS_URL=redis://default:password@host:6379

# ── Broker Integration ────────────────────────────────────
IB_API_BASE_URL=https://api.interactivebrokers.com
IB_API_KEY=your_ib_api_key
IB_ACCOUNT_ID=your_account_id

MT4_MANAGER_SERVER=your_mt4_server
MT4_MANAGER_LOGIN=your_login
MT4_MANAGER_PASSWORD=your_password

# MT4/5 Manager-API gateway (the native API is Windows C++; run it behind an
# HTTPS bridge that consumes the MT4_MANAGER_* creds above and exposes deals).
MT_GATEWAY_URL=https://mt-manager-gateway.example.com
MT_GATEWAY_KEY=your_gateway_key

# OCR fallback gateway (wraps Vision/Tesseract for statement uploads — low-trust)
OCR_GATEWAY_URL=https://ocr-gateway.example.com
OCR_GATEWAY_KEY=your_ocr_key

# Reward gate — min broker-confirmed closed volume (lots) to release rewards.
# NON-NEGOTIABLE: rewards only after broker-confirmed FTD + qualifying volume.
BROKER_MIN_QUALIFYING_LOTS=1

# ── Deploy ────────────────────────────────────────────────
# Which monorepo service this container runs (shared Dockerfile entrypoint).
SERVICE=api   # api | bot | broker-sync

# ── Payout ────────────────────────────────────────────────
PAYOUT_USDC_WALLET=your_bep20_wallet_address
PAYOUT_MIN_USD=20

# ── JWT / Session ─────────────────────────────────────────
JWT_SECRET=min_32_chars_random_secret

# ── CORS / Public URLs ────────────────────────────────────
LANDING_URL=https://fxking.io
API_URL=https://api.fxking.io
ADMIN_URL=https://admin.fxking.io

# ── Monitoring ────────────────────────────────────────────
SENTRY_DSN=your_sentry_dsn

# ── Compliance ────────────────────────────────────────────
# Allowed country ISO codes (ESMA/MNB review required before expanding)
ALLOWED_COUNTRIES=HU,AT,CZ,SK,RO,PL
